{
  "info": {
    "name": "Bank of CLI Part 3 | Shared API Tests",
    "description": "Team collection based on docs/api-contract.md in the Oct 20 ZIP. Import into Postman; set the loginPassword collection variable locally (demo: password1); run Login & save JWT; then run authenticated requests. Contract uses /auth/login, /accounts/me and /transactions/withdraw, while currently implemented HealthController uses /api/health. Ask the team whether to use a global /api prefix before changing apiPrefix. Several endpoints do not exist in the inspected snapshot: failed requests may reflect unfinished features, not collection errors. Only the successful withdrawal request mutates demo data. Do not export real tokens/passwords. Use Postman collection variables, not production credentials.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "94810aa9-7b02-48c6-9477-c5627c638f7e"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwtToken}}",
        "type": "string"
      }
    ]
  },
  "event": [],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "description": "Local Spring Boot server base URL",
      "type": "string"
    },
    {
      "key": "apiPrefix",
      "value": "/api",
      "description": "Optional global API prefix such as /api; contract currently shows no /api for auth and transactions",
      "type": "string"
    },
    {
      "key": "loginIdentifier",
      "value": "alice@bank.com",
      "description": "Demo user from docs/api-contract.md",
      "type": "string"
    },
    {
      "key": "loginPassword",
      "value": "",
      "description": "Set locally to the demo password (password1) in Postman; never put real passwords in shared exports",
      "type": "string"
    },
    {
      "key": "accountNumber",
      "value": "1000001234",
      "description": "Seed Alice account number; update if needed",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "description": "Auto-set by the Login & save JWT request after successful response",
      "type": "string"
    },
    {
      "key": "expiredJwtToken",
      "value": "",
      "description": "Paste a genuine expired token for the expiry scenario; a blank token only tests missing credentials",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 | Health check",
      "description": "The health request has its own /api path in the current controller.",
      "item": [
        {
          "name": "GET health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/health",
            "description": "Current server path /api/health is implemented; bypass optional apiPrefix for this request.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 | Authentication",
      "description": "",
      "item": [
        {
          "name": "Login & save JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/auth/login",
            "description": "Run after authentication endpoint is implemented. On HTTP 200, saves response.token into collection variable jwtToken. Uses contract path /auth/login. Check API prefix with team.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{loginIdentifier}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login returns HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test(\"Login includes a nonempty token\", function () {",
                  "    pm.expect(body.token).to.be.a(\"string\").and.not.empty;",
                  "  });",
                  "  if (typeof body.token === \"string\" && body.token.length > 0) {",
                  "    pm.collectionVariables.set(\"jwtToken\", body.token);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid credentials → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/auth/login",
            "description": "Expected by contract once auth is implemented.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"not-a-user@example.com\",\n  \"password\": \"incorrect-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });",
                  "pm.test(\"Contract error code\", function () {",
                  "  pm.expect(pm.response.json().code).to.eql(\"INVALID_CREDENTIALS\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 | Accounts",
      "description": "",
      "item": [
        {
          "name": "GET my account → 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/account/me",
            "description": "Needs signed JWT; runs after successful login. Uses inherited Bearer auth."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 | Withdrawals",
      "description": "",
      "item": [
        {
          "name": "Withdraw valid amount → 201 (changes balance)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/transactions/withdraw",
            "description": "WARNING: This moves 2500 cents ($25) from the demo account, so run only when you intend to mutate dev/test data.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"{{accountNumber}}\",\n  \"amountCents\": 2500\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Response includes newBalanceCents\", function () { pm.expect(pm.response.json()).to.have.property(\"newBalanceCents\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Withdraw zero amount → 400 INVALID_AMOUNT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/transactions/withdraw",
            "description": "Should not change account balance. Backend should return a standardized ApiError.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"{{accountNumber}}\",\n  \"amountCents\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Contract error code\", function () {",
                  "  pm.expect(pm.response.json().code).to.eql(\"INVALID_AMOUNT\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Withdraw insufficient funds → 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/transactions/withdraw",
            "description": "The contract permits up to 10,000,000,000 cents per transaction; seeded demo balance should be below this. Should not change funds.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"{{accountNumber}}\",\n  \"amountCents\": 10000000000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 422\", function () { pm.response.to.have.status(422); });",
                  "pm.test(\"Contract error code\", function () {",
                  "  pm.expect(pm.response.json().code).to.eql(\"INSUFFICIENT_FUNDS\");",
                  "});",
                  "pm.test(\"Correct invalid field\", function () { pm.expect(pm.response.json().field).to.eql(\"amountCents\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 | JWT security tests",
      "description": "SecurityConfig currently lacks a JWT filter and returns empty 401 via HttpStatusEntryPoint. These test expectations become valid only after JWT integration and contract-compliant security error handling.",
      "item": [
        {
          "name": "Missing JWT → 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/account/me",
            "description": "No Authorization header: expected HTTP 401 and ApiError UNAUTHORIZED after JWT security is implemented.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });",
                  "pm.test(\"Contract error code\", function () {",
                  "  pm.expect(pm.response.json().code).to.eql(\"UNAUTHORIZED\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Tampered JWT → 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/account/me",
            "description": "Uses a deliberately invalid bearer token.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "not-a-valid-jwt",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });",
                  "pm.test(\"Contract error code\", function () {",
                  "  pm.expect(pm.response.json().code).to.eql(\"UNAUTHORIZED\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Expired JWT → 401 (paste real expired token)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/account/me",
            "description": "Manually set expiredJwtToken to a genuine token that has passed its exp timestamp. A blank variable is not a real expiration test.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{expiredJwtToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });",
                  "pm.test(\"Contract error code\", function () {",
                  "  pm.expect(pm.response.json().code).to.eql(\"UNAUTHORIZED\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
